{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "eslint.config.js"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "sourceMap": true,
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@data/*": ["./src/data/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@schemas/*": ["./src/schemas/*"],
      "@scripts/*": ["./src/scripts/*"],
      "@utils/*": ["./src/utils/*"]
    }
  }
}
