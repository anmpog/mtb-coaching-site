---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import heroImage from '../assets/hero-img-lowres.jpg'

import heroData from '../data/site-data.json'
const { tagline, heroTitle, heroSubtext } = heroData
---

<Layout pageTitle='Home'>
  <div class='parallax'>
    <Image
      src={heroImage}
      class='hero-background'
      alt='Image of Max coaching several riders'
      layout='full-width'
    />
    <div class='hero-text'>
      <p class='hero-tagline'>{tagline}</p>
      <h1 class='hero-title'>{heroTitle}</h1>
      <p class='hero-subtext'>{heroSubtext}</p>
      <button class='hero-cta'>Book Now</button>
    </div>
  </div>
</Layout>
<style>
  .parallax {
    position: relative;
    min-height: calc(100vh - var(--nav-height-mobile));
    display: grid;
    grid-template-areas: 'stack';
    align-content: stretch;
  }

  .parallax > * {
    grid-area: stack;
  }

  .hero-background {
    display: block;
    object-fit: cover;
    height: 100%;
    width: 100%;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-self: start;
    justify-self: center;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    height: 100%;
    background-color: rgb(0 0 0 / 50%);
    gap: 1.5rem;
  }

  .hero-tagline {
    color: white;
    text-transform: uppercase;
  }

  .hero-subtext {
    @apply text-xl;
    color: white;
    text-transform: capitalize;
    text-align: center;
  }

  .hero-title {
    @apply text-6xl;
    @apply tracking-widest;
    font-family: 'Raleway';
    text-align: center;
    color: white;
    text-transform: uppercase;
  }

  .hero-cta {
    @apply border border-neutral-950 bg-neutral-950 px-7 py-2 text-neutral-200;
    box-sizing: border-box;
  }

  .hero-cta:hover {
    @apply border border-neutral-950 bg-neutral-200 text-neutral-950 transition-colors duration-500;
  }

  /* 768px comes from default "medium screen" value in Tailwind 3 */
  /* @media (width >= 768px) { */
  @media (width >= 768px) {
    .parallax {
      min-height: 75vh;
    }

    .hero-subtext {
      @apply text-2xl;
    }

    .hero-tagline {
      @apply text-lg;
    }

    .hero-title {
      @apply text-8xl;
      letter-spacing: 1rem;
    }

    .hero-text {
      @apply px-8 py-4;
      border: 2px solid;
      border-color: var(--active-link);
      max-width: 85ch;
      background-color: rgb(0 0 0 / 50%);
      margin-top: 6em;
      height: auto;
    }
  }
</style>
