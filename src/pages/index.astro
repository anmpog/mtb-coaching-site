---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import heroImage from '../assets/hero-img-lowres.jpg'
import heroData from '../data/site-data.json'
import SideBySide from '../components/SideBySide.astro'
import sideBySideImg1 from '../assets/home-side-by-side-1.jpg'
import sideBySideImg2 from '../assets/home-side-by-side-2.jpg'
import SideBySideText from '../components/SideBySideText.astro'
import SideBySideImage from '../components/SideBySideImage.astro'
const { tagline, heroTitle, heroSubtext } = heroData
---

<Layout pageTitle='Home'>
  <div class='parallax'>
    <Image
      alt='Image of Max coaching several riders'
      class='hero-background'
      layout='full-width'
      src={heroImage}
    />
    <div class='hero-text'>
      <p class='hero-tagline'>{tagline}</p>
      <h1 class='hero-title'>{heroTitle}</h1>
      <p class='hero-subtext'>{heroSubtext}</p>
      <button class='hero-cta'>Book Now</button>
    </div>
  </div>
  <SideBySide contentDirection='content-image'>
    <SideBySideImage
      altText='An picture of Max and a client examining trail conditions'
      imageSrc={sideBySideImg1}
      slot='image'
    />
    <SideBySideText
      content=`Max MTB Coaching is a professional mountain bike coaching service based in Southern California, including the Los Angeles area, Orange County and San Diego County. Our mission is to help riders of all abilities bring their skills and confidence to new levels. Whether you're just starting out or looking to refine your technique, our private and small group coaching sessions and skills clinics are designed to help you achieve your goals. We're passionate about mountain biking and want to share our knowledge and expertise with you.`
      contentTitle='About Us'
      slot='content'
    />
  </SideBySide>

  <SideBySide contentDirection='image-content'>
    <SideBySideImage
      altText='A picture of Max bunny-hopping against a background of the sunset and the ocean'
      imageSrc={sideBySideImg2}
      slot='image'
    />
    <SideBySideText
      content='where is my content'
      contentTitle='Be the first to know'
      slot='content'
    />
  </SideBySide>
</Layout>
<style>
  .parallax {
    position: relative;
    min-height: calc(100vh - var(--nav-height-mobile));
    display: grid;
    grid-template-areas: 'stack';
    align-content: stretch;
    overflow-x: hidden;
  }

  .parallax > * {
    grid-area: stack;
  }

  .hero-background {
    display: block;
    object-fit: cover;
    height: 100%;
    width: 100%;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-self: start;
    justify-self: center;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    height: 100%;
    background-color: rgb(0 0 0 / 50%);
    gap: 1.5rem;
  }

  .hero-tagline {
    color: white;
    text-transform: uppercase;
  }

  .hero-subtext {
    @apply text-xl;
    color: white;
    text-transform: capitalize;
    text-align: center;
  }

  .hero-title {
    @apply text-6xl;
    @apply tracking-widest;
    font-family: 'Raleway';
    text-align: center;
    color: white;
    text-transform: uppercase;
  }

  .hero-cta {
    @apply border border-neutral-950 bg-neutral-950 px-7 py-2 text-neutral-200;
    box-sizing: border-box;
  }

  .hero-cta:hover {
    @apply border border-neutral-950 bg-neutral-200 text-neutral-950 transition-colors duration-500;
  }

  /* 768px comes from default "medium screen" value in Tailwind 3 */
  /* @media (width >= 768px) { */
  @media (width >= 768px) {
    .parallax {
      min-height: 75vh;
    }

    .hero-subtext {
      @apply text-2xl;
    }

    .hero-tagline {
      @apply text-lg;
    }

    .hero-title {
      @apply text-8xl;
      letter-spacing: 1rem;
    }

    .hero-text {
      @apply px-8 py-4;
      border: 2px solid;
      border-color: var(--active-link);
      max-width: 85ch;
      background-color: rgb(0 0 0 / 50%);
      margin-top: 6em;
      height: auto;
    }
  }
</style>
