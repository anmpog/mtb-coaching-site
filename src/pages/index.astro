---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import heroImage from '../assets/hero-img-lowres.jpg'

import heroData from '../data/site-data.json'
const { tagline, heroTitle, heroSubtext } = heroData
---

<Layout pageTitle='Home'>
  <div class='parallax'>
    <Image
      src={heroImage}
      class='hero-background'
      alt='Image of Max coaching several riders'
      layout='full-width'
    />
    <!-- <div class='hero-text'>
      <p class='hero-tagline'>{tagline}</p>
      <h1 class='hero-title'>{heroTitle}</h1>
      <p class='hero-subtext'>{heroSubtext}</p>
      <button class='hero-cta'>Book Now</button>
    </div> -->
  </div>
</Layout>
<style>
  .parallax {
    position: relative;
    z-index: 0;
    min-height: 75vh;
    display: grid;
    grid-template-areas: 'stack';
    /* grid-template-rows: 1fr; */
    align-content: stretch;
    outline: 5px solid fuchsia;
  }

  .parallax > * {
    grid-area: stack;
    /* animation: parallax linear;
    animation-timeline: scroll(); */
  }

  .parallax img {
    border: 4px solid blue;
    display: block;
    object-fit: cover;
    height: 100%;
    width: 100%;
  }

  /* .hero-text * + * {
    margin-top: 1rem;
  } */

  .hero-tagline {
    @apply text-lg;
    color: white;
    text-transform: uppercase;
  }

  .hero-subtext {
    @apply text-2xl;
    color: white;
    text-transform: capitalize;
  }

  .hero-title {
    @apply text-8xl;
    color: white;
    text-transform: capitalize;
  }

  .hero-cta {
    @apply border border-neutral-950 bg-neutral-950 px-7 py-2 text-neutral-200;
    box-sizing: border-box;
  }

  .hero-cta:hover {
    @apply border border-neutral-950 bg-neutral-200 text-neutral-950 transition-colors duration-500;
  }

  @keyframes parallax {
    to {
      transform: translateY(calc(var(--parallax-speed * 2000px)));
    }
  }
</style>
