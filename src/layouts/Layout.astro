---
import '@assets/main.css'
import Footer from '@components/Footer.astro'
import siteData from '@data/site-data.json'
import Navigation from '@components/Navigation.astro'
import { Font } from 'astro:assets'

export interface Props {
  /** The string representing the title of the current page used for SEO. */
  pageTitle: string

  /** A generated string representing the site's title used for SEO. */
  siteTitle?: string
}

const { siteTitle = siteData.siteTitle, pageTitle } = Astro.props
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta content='width=device-width, initial-scale=1' name='viewport' />
    <meta content={Astro.generator} name='generator' />
    <!-- Favicon -->
    <link href='/favicon-32x32.png' rel='icon' sizes='32x32' type='image/png' />
    <link href='/favicon-16x16.png' rel='icon' sizes='16x16' type='image/png' />

    <!-- Fonts -->
    <Font cssVariable='--font-rubik' />
    <Font cssVariable='--font-raleway' />

    <!-- Apple Touch Icons -->
    <link href='/apple-touch-icon.png' rel='apple-touch-icon' sizes='180x180' />
    <title>{`${pageTitle} | ${siteTitle}`}</title>
  </head>
  <body class='flex min-h-screen flex-col'>
    <header>
      <Navigation />
    </header>
    <main class='h-full flex-1' id='main-content'>
      <slot />
    </main>
    <footer id='footer'>
      <Footer />
    </footer>
  </body>
</html>
