---
import { Icon } from 'astro-icon/components'

export interface Props {
  /**
   * @param title - A title for the social link
   */
  title: string

  /**
   * @param address - A valid web address for the social link to navigate to
   */
  address: string

  /**
   * @param iconName - The name of an icon in the Ion icon library.
   */
  iconName: string

  /**
   * @param size - A number value that will represent the icon's height and width in pixels
   *
   * @defaultValue 36
   */
  size?: number
}
const { title, address, iconName, size = 36 } = Astro.props
---

<a href={address} title={title}>
  <Icon
    aria-hidden='true'
    focusable='false'
    name={`ion:${iconName}`}
    size={size}
  />
</a>
