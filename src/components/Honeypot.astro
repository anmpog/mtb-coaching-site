---
export interface Props {
  /**
   * Must match the `id` attribute of the enclosing `<form>` element.
   * Used to namespace the honeypot field's id, name, and error elements.
   *
   * @example
   * <form id="signup">
   *   <Honeypot formName="signup" />
   * </form>
   *
   * @default: 'form'
   */
  netlifyHoneypotName?: string
}

const { netlifyHoneypotName = 'form' } = Astro.props
---

<div aria-hidden='true' class='form-control'>
  <label for='confirmation-field'>Confirm Email</label>
  <input
    aria-describedby='confirmation-field-error'
    autocomplete='off'
    id='confirmation-field'
    maxlength='254'
    minlength='2'
    name={netlifyHoneypotName}
    placeholder='e.g. Confirm Email'
    tabindex='-1'
    type='email'
  />
  <p class='confirmation-field-error' id='confirmation-field-error'>
    Please confirm your email address.
  </p>
</div>
<style>
  .form-control {
    opacity: 0;
    position: absolute;
    inset: 0;
    height: 0;
    width: 0;
    z-index: -9999;
    overflow: hidden;
    pointer-events: none;
  }
</style>
