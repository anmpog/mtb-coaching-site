---
export interface Props {
  /** Value for the `name` attribute of the underlying <input /> in the honeypot field. *
   * @example
   * ```html
   * <form id="signup">
   *   <Honeypot netlifyHoneypotName="signup" />
   * </form>
   *```
   * @defaultValue form
   */
  netlifyHoneypotName?: string
}

const { netlifyHoneypotName = 'form' } = Astro.props
---

<div aria-hidden='true' class='form-control' data-optional>
  <label for='confirmation-field'>Confirm Email</label>
  <input
    aria-describedby='confirmation-field-error'
    autocomplete='off'
    id='confirmation-field'
    maxlength='254'
    minlength='2'
    name={netlifyHoneypotName}
    placeholder='e.g. Confirm Email'
    tabindex='-1'
    type='email'
  />
  <p class='confirmation-field-error' id='confirmation-field-error'>
    Please confirm your email address.
  </p>
</div>
<style>
  .form-control {
    opacity: 0;
    position: absolute;
    inset: 0;
    height: 0;
    width: 0;
    z-index: -9999;
    overflow: hidden;
    pointer-events: none;
  }
</style>
