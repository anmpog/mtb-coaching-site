---
export interface Props {
  /**
   * Must match the `id` attribute of the enclosing `<form>` element.
   * Used to namespace the honeypot field's id, name, and error elements.
   *
   * @example
   * <form id="signup">
   *   <Honeypot formName="signup" />
   * </form>
   *
   * @default: 'form'
   */
  formName?: string
}

const { formName = 'form' } = Astro.props

// Linter was complaining about string interpolation
const formId = `${formName}-confirm-email`
---

<div aria-hidden='true' class='form-control'>
  <label for={formId}>Confirm Email</label>
  <input
    aria-describedby={`${formName}-confirm-email-error`}
    autocomplete='off'
    id={formId}
    maxlength='254'
    minlength='2'
    name={formId}
    placeholder='e.g. Confirm Email'
    tabindex='-1'
    type='text'
  />
  <p
    class={`${formName}-confirm-email-error`}
    id={`${formName}-confirm-email-error`}
  >
    Please confirm your email address.
  </p>
</div>
<style>
  .form-control {
    opacity: 0;
    position: absolute;
    inset: 0;
    height: 0;
    width: 0;
    z-index: -9999;
    overflow: hidden;
    pointer-events: none;
  }
</style>
