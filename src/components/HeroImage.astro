---
import { Image } from 'astro:assets'
import heroImage from '../assets/hero-img-lowres.jpg'
import heroData from '../data/site-data.json'
const { tagline, heroTitle, heroSubtext } = heroData
---

<div
  class='relative grid min-h-[calc(100vh-var(--nav-height-mobile))] content-stretch overflow-x-hidden [grid-template-areas:"stack"] md:min-h-[75vh]'
>
  <Image
    alt='Image of Max coaching several riders'
    class='block h-full w-full object-cover [grid-area:stack]'
    layout='full-width'
    src={heroImage}
  />
  <div
    class='h-full w-full border-2 border-active-link bg-slate-950/55 [grid-area:stack]'
  >
  </div>

  <div
    class='mt-[calc(50%-var(--nav-height-mobile))] flex flex-col flex-wrap items-center justify-center gap-4 self-start justify-self-center px-6 py-14 [grid-area:stack] md:mt-[6em] md:max-w-[85ch] md:gap-6 md:px-8 md:py-4'
  >
    <p
      class='order-2 text-center text-base uppercase tracking-widest text-slate-50 md:order-none md:text-lg'
    >
      {tagline}
    </p>
    <h1
      class='order-1 text-center font-heading text-5xl uppercase tracking-widest text-slate-50 md:order-none md:text-8xl'
    >
      {heroTitle}
    </h1>
    <p class='hidden text-xl capitalize text-slate-50 md:block md:text-2xl'>
      {heroSubtext}
    </p>
    <button class='btn btn-primary order-3 md:order-none'>Book Now</button>
  </div>
</div>
