---
import Honeypot from './Honeypot.astro'
import SubmitButton from './SubmitButton.astro'
---

<form
  aria-label='Newsletter Sign Up'
  data-netlify='true'
  data-schema='signup-form'
  id='signup-form'
  method='post'
  name='signup-form'
  netlify-honeypot='signup-confirm'
>
  <input hidden name='form-name' value='signup-form' />
  <div class='form-control'>
    <label for='signup-email'>Enter Your Email</label>
    <input
      aria-describedby='signup-email-error'
      aria-invalid='false'
      autocomplete='email'
      id='signup-email'
      maxlength='254'
      name='signup-email'
      placeholder='e.g. your-address@domain.com'
      required
      type='email'
    />
    <span
      class='signup-email-error'
      data-default-error-message='Enter a correctly formatted email address.'
      id='signup-email-error'
      role='alert'
    >
      Enter a correctly formatted email address.
    </span>
  </div>
  <Honeypot netlifyHoneypotName='signup-confirm' />
  <SubmitButton variant='btn-secondary' />
  <span
    aria-atomic='true'
    aria-live='polite'
    class='sr-only'
    data-default-status-text='Form idle'
    id='form-status'>Form idle</span
  >
  <script>
    import '../scripts/form-submit'
  </script>
</form>
