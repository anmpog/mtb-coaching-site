---
import Honeypot from './Honeypot.astro'
import SubmitButton from './SubmitButton.astro'
---

<form
  aria-label='Newsletter Sign Up'
  data-netlify='true'
  data-schema='signup-form'
  id='newsletter-form'
  method='post'
  name='newsletter-form'
  netlify-honeypot='newsletter-confirm'
>
  <input hidden name='form-name' value='signup-form' />=
  <div class='form-control'>
    <label for='newsletter-email'>Enter Your Email</label>
    <input
      aria-describedby='newsletter-email-error'
      aria-invalid='false'
      autocomplete='email'
      id='newsletter-email'
      maxlength='254'
      name='newsletter-email'
      placeholder='e.g. your-address@domain.com'
      required
      type='email'
    />
    <span
      class='newsletter-email-error'
      data-default-error-message='Enter a correctly formatted email address.'
      id='newsletter-email-error'
      role='alert'
    >
      Enter a correctly formatted email address.
    </span>
  </div>
  <Honeypot netlifyHoneypotName='newsletter-confirm' />
  <SubmitButton variant='btn-secondary' />
  <span
    aria-atomic='true'
    aria-live='polite'
    class='sr-only'
    data-default-status-text='Form idle'
    id='form-status'>Form idle</span
  >
  <script>
    import '../scripts/form-submit'
  </script>
</form>
