---
export interface Props {
  /**
   * A title for the textual content. Will be fully uppercase.
   */
  contentTitle: string
  /**
   * The html heading element to represent the content title.
   * @defaultValue h2
   */
  headingTag?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5'
  /**
   * The text content to display. Use backticks (\`\`) to avoid having to escape special characters. Will appear under the content title.
   */
  content: string
}

/**
 * Optional additional content rendered below the text, e.g. a form component
 * @slot non-textual-content
 */

const { contentTitle, headingTag = 'h2', content } = Astro.props
const hasNonTextualContent = Astro.slots.has('non-textual-content')
const HeadingTag = headingTag
---

<div
  class='flex h-full flex-col px-6 py-14 font-sans outline-2 outline-red-400'
  id='side-by-side-text'
>
  <div class='flex h-full flex-col justify-center'>
    <div class='flow-content' id='text-content'>
      <HeadingTag class='text-left uppercase'>
        {contentTitle}
      </HeadingTag>
      <p class='max-w-[45ch]'>
        {content}
      </p>
    </div>
    {
      hasNonTextualContent ? (
        <div class='mt-3' id='non-textual-content'>
          <slot name='non-textual-content' />
        </div>
      ) : null
    }
  </div>
</div>
