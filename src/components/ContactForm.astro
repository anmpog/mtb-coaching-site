---
import { Icon } from 'astro-icon/components'
import Honeypot from './Honeypot.astro'
---

<form
  aria-label='Contact Us'
  data-netlify='true'
  data-schema='contact-form'
  id='contact-form'
  name='contact-form'
  netlify-honeypot='contact-confirm'
>
  <h2 class='text-left font-heading text-3xl uppercase tracking-widest'>
    Drop Us A Line
  </h2>
  <div class='form-control'>
    <label for='name'>Your Name</label>
    <input
      aria-describedby='name-error'
      autocomplete='given-name'
      id='name'
      maxlength='100'
      minlength='2'
      name='name'
      placeholder='e.g. Brandon Semenuk'
      required
      type='text'
    />
    <p
      class='name-error'
      data-default-error-message='Name must be longer'
      id='name-error'
    >
      Name must be longer.
    </p>
  </div>
  <div class='form-control'>
    <label for='contact-email'>Your Email</label>
    <input
      aria-describedby='contact-email-error'
      autocomplete='email'
      id='contact-email'
      maxlength='254'
      name='contact-email'
      placeholder='e.g. your-address@domain.com'
      required
      type='email'
    />
    <p
      class='contact-email-error'
      data-default-error-message='Enter a correctly formatted email address'
      id='contact-email-error'
    >
      Enter a correctly formatted email address.
    </p>
  </div>
  <Honeypot netlifyHoneypotName='contact-confirm' />
  <div class='form-control'>
    <label for='subject'>Subject</label>
    <input
      aria-describedby='subject-error'
      autocomplete='off'
      id='subject'
      maxlength='150'
      minlength='3'
      name='subject'
      placeholder='e.g. Want to learn manuals!'
      required
      type='text'
    />
    <p
      class='subject-error'
      data-default-error-message='Enter a longer subject (3 characters)'
      id='subject-error'
    >
      Enter a longer subject (3 characters).
    </p>
  </div>
  <div class='form-control'>
    <label for='message'>Message</label>
    <textarea
      aria-describedby='message-error'
      autocomplete='off'
      id='message'
      maxlength='1000'
      minlength='10'
      name='message'
      placeholder='Can you teach me how to manual this week?'
      required
      rows='6'></textarea>
    <p
      class='message-error'
      data-default-error-message='Enter a longer message (10 characters)'
      id='message-error'
    >
      Enter a longer message (10 characters).
    </p>
  </div>
  <button
    class='btn-primary flex items-center justify-center gap-2'
    type='submit'
  >
    <Icon
      class='contact-form-success'
      name='ion:checkmark-done-circle-outline'
      size={24}
    />
    <span>Submit</span>
  </button>
  <script>
    import '../scripts/form-submit'
  </script>
</form>
