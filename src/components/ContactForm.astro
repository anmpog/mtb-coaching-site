---
import Honeypot from '@components/Honeypot.astro'
import SubmitButton from '@components/SubmitButton.astro'
---

<form
  aria-label='Contact Us'
  data-netlify='true'
  data-schema='contact-form'
  id='contact-form'
  method='post'
  name='contact-form'
  netlify-honeypot='contact-confirm'
>
  <h2 class='text-left uppercase'>Drop Us A Line</h2>
  <input hidden name='form-name' value='contact-form' />
  <div class='form-control'>
    <label for='name'>Your Name</label>
    <input
      aria-describedby='name-error'
      aria-invalid='false'
      autocomplete='given-name'
      id='name'
      maxlength='100'
      minlength='2'
      name='name'
      placeholder='e.g. Brandon Semenuk'
      required
      type='text'
    />
    <span
      class='name-error'
      data-default-error-message='Name must be longer'
      id='name-error'
    >
      Name must be longer
    </span>
  </div>
  <div class='form-control'>
    <label for='contact-email'>Your Email</label>
    <input
      aria-describedby='contact-email-error'
      aria-invalid='false'
      autocomplete='email'
      id='contact-email'
      maxlength='254'
      name='contact-email'
      placeholder='e.g. your-address@domain.com'
      required
      type='email'
    />
    <span
      class='contact-email-error'
      data-default-error-message='Enter a correctly formatted email address'
      id='contact-email-error'
    >
      Enter a correctly formatted email address
    </span>
  </div>
  <Honeypot netlifyHoneypotName='contact-confirm' />
  <div class='form-control'>
    <label for='subject'>Subject</label>
    <input
      aria-describedby='subject-error'
      aria-invalid='false'
      autocomplete='off'
      id='subject'
      maxlength='150'
      minlength='3'
      name='subject'
      placeholder='e.g. Want to learn manuals!'
      required
      type='text'
    />
    <span
      class='subject-error'
      data-default-error-message='Enter a longer subject (3 characters)'
      id='subject-error'
    >
      Enter a longer subject (min: 3 characters)
    </span>
  </div>
  <div class='form-control'>
    <label for='message'>Message</label>
    <textarea
      aria-describedby='message-error'
      aria-invalid='false'
      autocomplete='off'
      id='message'
      maxlength='1000'
      minlength='10'
      name='message'
      placeholder='Can you teach me how to manual this week?'
      required
      rows='6'></textarea>
    <span
      class='message-error'
      data-default-error-message='Enter a longer message (10 characters)'
      id='message-error'
    >
      Enter a longer message (10 characters)
    </span>
  </div>
  <SubmitButton variant='btn-primary' />
  <span
    aria-atomic='true'
    aria-live='polite'
    class='sr-only'
    data-default-status-text='Form idle'
    id='form-status'>Form idle</span
  >
  <script>
    import '@scripts/form-submit'
  </script>
</form>
