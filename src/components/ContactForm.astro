<form>
  <div class='form-control'>
    <label for='name'>Your Name</label>
    <input
      aria-describedby='name-error'
      id='name'
      maxlength='100'
      minlength='2'
      name='name'
      placeholder='e.g. Brandon Semenuk'
      required
      type='text'
    />
    <p class='name-error' id='name-error'>Name must be longer.</p>
  </div>
  <div class='form-control'>
    <label for='email'>Your Email</label>
    <input
      aria-describedby='email-error'
      id='email'
      maxlength='254'
      name='email'
      placeholder='e.g. your-address@domain.com'
      required
      type='email'
    />
    <p class='email-error' id='email-error'>
      Enter a correctly formatted email address.
    </p>
  </div>
  <div class='form-control'>
    <label for='subject'>Subject</label>
    <input
      aria-describedby='subject-error'
      autocomplete='off'
      id='subject'
      maxlength='150'
      minlength='3'
      name='subject'
      placeholder='e.g. Want to learn manuals!'
      required
      type='text'
    />
    <p class='subject-error' id='subject-error'>
      Enter a longer subject (3 characters).
    </p>
  </div>
  <div class='form-control'>
    <label for='message'>Message</label>
    <textarea
      aria-describedby='message-error'
      autocomplete='off'
      id='message'
      maxlength='1000'
      minlength='10'
      name='message'
      placeholder='Can you teach me how to manual this week?'
      required
      rows='6'></textarea>
    <p class='message-error' id='message-error'>
      Please enter a longer message.
    </p>
  </div>
  <input class='btn btn-primary w-48 self-end' type='submit' value='Submit' />
</form>

<style>
  form {
    @apply flex flex-col gap-2;
  }

  .form-control {
    @apply flex flex-col;
  }

  .form-control label {
    @apply font-semibold;
  }

  .form-control input,
  .form-control textarea {
    @apply mt-1 border-2 border-neutral-950 p-1.5;
  }

  .form-control textarea {
    @apply resize-none;
  }

  /* Hide errors by default */
  .form-control [class$='-error'] {
    @apply invisible text-sm font-semibold text-red-700;
  }

  /* FALLBACK: only active if browser does not support :user-invalid */
  @supports not selector(:user-invalid) {
    /* This selector is whack. The thought is:
        * placeholder not shown means user interacted
        * don't want error to show during focus
        * want error to show if input is invalid
        * targets visibility of <p> with error class
    */
    .form-control
      input:invalid:not(:focus):not(:placeholder-shown)
      ~ [class$='-error'],
    .form-control
      textarea:invalid:not(:focus):not(:placeholder-shown)
      ~ [class$='-error'] {
      visibility: visible;
    }
  }

  /* ENHANCED: only active in browsers that support :user-invalid */
  @supports selector(:user-invalid) {
    .form-control input:user-invalid ~ [class$='-error'],
    .form-control textarea:user-invalid ~ [class$='-error'] {
      visibility: visible;
    }
  }

  /* Red border while invalid and touched */
  .form-control input:user-invalid:not(:placeholder-shown),
  .form-control textarea:user-invalid:not(:placeholder-shown) {
    @apply border-red-700;
  }

  /* Green border when valid and touched */
  /* .form-control input:valid:not(:placeholder-shown),
  .form-control textarea:valid:not(:placeholder-shown) {
    border-color: #15803d;
  } */
</style>
