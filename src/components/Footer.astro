---
import logo from '@assets/max-mtb-logo.png'
import ContactForm from '@components/ContactForm.astro'
import SocialLinks from '@components/SocialLinks.astro'
import siteData from '@data/site-data.json'
import { Image } from 'astro:assets'
const { logoType, siteTitle, contactInfo } = siteData
---

<footer class='bg-brand-blue min-h-36 pt-9'>
  <div
    class='mx-auto grid max-w-4xl grid-cols-1 gap-8 p-4 md:grid-cols-2 md:gap-4'
  >
    <div class='flex flex-col gap-8 md:col-span-1'>
      <section id='logo-section'>
        <Image alt='Max MTB Logo' src={logo} />
        <span class='font-heading text-xl tracking-wider'>{siteTitle}</span>
        <p>{logoType}</p>
      </section>
      <section id='contact-section'>
        <h2 class='text-left font-heading text-3xl uppercase tracking-widest'>
          Contact
        </h2>
        <address>
          <ul aria-label='contact information'>
            {
              contactInfo.map(({ type, address, label }) => {
                let formattedTel = undefined
                // Remove dashes
                if (type === 'tel') {
                  formattedTel = address.replace(/[^\d+]/g, '')
                }
                return (
                  <li>
                    <a href={`${type}:${formattedTel}`}>
                      <span class='font-bold uppercase not-italic'>
                        {label}:
                      </span>
                      {address}
                    </a>
                  </li>
                )
              })
            }
          </ul>
        </address>
      </section>
      <section id='socials-section'>
        <h2 class='text-left font-heading text-3xl uppercase tracking-widest'>
          Follow us
        </h2>
        <SocialLinks />
      </section>
    </div>
    <div>
      <ContactForm />
    </div>
  </div>
  <p class='mt-[3em] pb-6 text-center font-bold'>
    &copy;<span aria-label='copyright year' id='year'></span>&nbsp;Max MTB
    Coaching
  </p>
  <script>
    const yearElement = document.getElementById('year')
    if (yearElement) {
      yearElement.textContent = new Date().getFullYear().toString()
    }
  </script>
</footer>
