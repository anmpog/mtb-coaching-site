---
import { Fragment } from 'astro/jsx-runtime'

export interface Props {
  /**
   * Left-to-right layout on larger screens. Determines orientation of non-image content in relation to an image. Expected that side-by-side will always show an image on one half, and some other form of content (text, a form, etc.) on the other half. Small screens will default to a column in which textual content appears above non-textual content. Desktop layout will default to content on the left half of the view, and an image on the right half of the view.
   *
   *
   * @default 'content-image'
   */
  contentDirection?: 'content-image' | 'image-content'
}

const { contentDirection = 'content-image' } = Astro.props
---

<div
  id='side-by-side'
  class=`flex flex-col md:flex-row ${contentDirection === 'image-content' ? 'md:flex-row-reverse' : ''}`
  data-content-direction={contentDirection}
>
  <div id='side-by-side-image' class='min-w-0 flex-1'>
    <slot name='content' />
  </div>
  <div id='side-by-side-content' class='min-w-0 flex-1'>
    <slot name='image' />
  </div>
</div>
