---
import type { NavigationLink } from './navigation.types';

export interface Props extends NavigationLink {
  /** A generated string value used for applying `.active` styling to nav links based on user's current location in the site. */
  currentPath: string
}

const { title, path, subNavOptions } = Astro.props
const requestPath = new URL(Astro.request.url).pathname
const currentPath = requestPath.split('/')[1]
---

<a
  class:list={[
    currentPath === path.slice(1) ? 'active' : '',
    'navigation-link',
  ]}
  data-text={title}
  href={path}
>
  {title}
</a>
<!-- {
  subNavOptions ? (
    <SubnavigationMenu subNavigationOptions={subNavOptions} />
  ) : null
} -->
<style>
  /* Layout for no-JS environments */
  .navigation-link {
    text-decoration: none;
    font-size: theme(fontSize.fs-base);
    font-weight: theme(fontWeight.normal);
    display: inline-grid;
    padding: theme(space.1) theme(space.3);
    width: 100%;
    text-align: center;
    color: theme(colors.slate.600);
  }

  .navigation-link::after {
    content: attr(data-text);
    height: 0;
    font-weight: 750;
    grid-area: 1/1;
    user-select: none;
    pointer-events: none;
    visibility: hidden;
  }

  .navigation-link.active {
    /* --focus-color allows override of currentColor so that focus outline is more visible */
    --focus-color: theme('colors.brand-blue');
    font-weight: theme(fontWeight.semibold);
    background-color: theme('colors.active-link');
    color: theme(colors.slate.100);
  }

  .navigation-link:hover:not(.active) {
    font-weight: theme(fontWeight.semibold);
    color: theme(colors.slate.700);
  }

  @media (max-width: theme(screens.sm)) {
    :global(burger-menu.js-enabled) .navigation-link {
      padding: theme(space.3) theme(space.7);
      border-radius: theme(borderRadius.DEFAULT);
      font-size: theme(fontSize.fs-md);
    }
  }
</style>
