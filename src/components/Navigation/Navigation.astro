---
import logo from '@assets/max-mtb-logo.png'
import siteData from '@data/site-data.json'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import NavLink from './NavLink.astro'
const { navLinks, logoType } = siteData

const requestPath = new URL(Astro.request.url).pathname

// Normalizing path because production env adds trailing slash
const currentPath = requestPath.split('/')[1]
---

<div id='main-navigation'>
  <a href='/' id='logo-link'>
    <Image alt='Max MTB Logo' id='logo-img' src={logo} />
  </a>
  <div class='logo-type' id='logo-type'>
    <span class='font-semibold'>{logoType}</span>
  </div>
  <button
    aria-controls='menu-wrapper'
    aria-describedby='button-label'
    aria-expanded='false'
    aria-label='Mobile Navigation Menu Toggle'
    id='nav-menu-button'
    tabindex='0'
  >
    <Icon focusable='false' name={'ion:menu'} title='site navigation' />
    <span hidden id='button-label'>Site Navigation</span>
  </button>
  <nav id='menu-wrapper'>
    <ul aria-label='Navigation Links' id='navigation-menu'>
      {
        navLinks.map(({ title, path, subNavOptions }) => (
          <li data-subnavigation={subNavOptions ? 'true' : 'false'}>
            <NavLink
              currentPath={currentPath}
              path={path}
              subNavOptions={subNavOptions}
              title={title}
            />
          </li>
        ))
      }
    </ul>
  </nav>

  <script>
    import '@scripts/nav-menu.ts'
  </script>
</div>
<style>
  /* Layout for no-JS environments */
  #main-navigation {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto auto;
    min-height: theme(height.24);
    row-gap: theme(space.3);
    z-index: 1;
    padding-top: theme(space.3);
  }

  #main-navigation::before {
    display: none;
  }

  #nav-menu-button {
    display: none;
  }

  #menu-wrapper {
    grid-row: 2;
    grid-column: 1 / 5;
    top: 100%;
    flex-direction: row;
    /* border: 10px solid red; */
  }

  ul#navigation-menu {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    background-color: transparent;
    outline: 2px solid theme(colors.slate.800);
  }

  ul#navigation-menu li {
    min-width: 0;
  }

  #logo-link {
    grid-row: 1;
    grid-column: 1 / 2;
    height: theme(space.16);
    width: theme(space.16);
    align-self: center;
    justify-self: center;
  }

  #logo-type {
    grid-row: 1;
    grid-column: 2 / 5;
    flex-shrink: 0;
    display: block;
    justify-self: center;
    align-self: center;
  }

  #logo-type span {
    font-weight: bold;
    text-align: center;
  }

  /* Layout for JS environments */
  body.js-enabled nav {
    display: flex;
    justify-content: space-between;
    height: theme(height.24);
    align-items: center;
    gap: theme(space.2);
  }

  /* Want to appear between navigation menu wrapper and primary page content */
