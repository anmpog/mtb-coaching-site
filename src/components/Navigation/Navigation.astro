  @media (width >= theme(screens.sm)) {
    #main-navigation {
      /* border: 10px solid red; */
    }

    body.js-enabled #navigation-menu {
      grid-column-start: 4;
      grid-column-end: 10;
      margin: 0 auto;
    }
  }

  @media (width >= theme(screens.md)) {
    #main-navigation {
      max-width: theme(maxWidth.6xl);
      display: flex;
      align-items: center;
      margin: 0 auto;
      justify-content: space-between;
      padding: 0 theme(space.3);
      /* border: 10px solid blue; */
    }

    #menu-wrapper {
      /* position: relative; */
      /* display: inline; */
      visibility: visible;
      transition: none;
      width: auto;
      border-bottom: none;
      background: none;
    }

    ul#navigation-menu {
      display: flex;
      flex-direction: row;
      padding: 0;
      outline: none;
    }

    #nav-menu-button {
      display: none;
    }
    /* body.js-enabled #nav-menu-button {
      display: none;
    } */

    #menu-backdrop {
      display: none;
    }

    li[data-subnavigation='true'] {
      position: relative;
      display: flex;
      align-items: stretch;
      gap: theme(space.2);
    }
  }
</style>
