---
import logo from '@assets/max-mtb-logo.png'
import siteData from '@data/site-data.json'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import NavLink from './NavLink.astro'
const { navLinks, logoType } = siteData

const requestPath = new URL(Astro.request.url).pathname
// Normalizing path because production env adds trailing slash
const currentPath = requestPath.split('/')[1]
---

<nav class='main-nav' id='main-nav'>
  <div class='backdrop' id='menu-backdrop'></div>
  <a href='/' id='logo-link'>
    <Image alt='Max MTB Logo' id='logo-img' src={logo} />
  </a>
  <div class='logo-type' id='logo-type'>
    <span class='font-semibold'>{logoType}</span>
  </div>
  <button aria-expanded='false' aria-labelledby='button-label' id='menu-button'>
    <Icon focusable='false' name={'ion:menu'} title='site navigation' />
    <span hidden id='button-label'>Site Navigation</span>
  </button>

  <div id='menu-wrapper'>
    <ul id='navigation-menu'>
      {
        navLinks.map(({ title, path, subPaths }) => (
          <li data-subpaths={subPaths ? 'true' : 'false'}>
            <NavLink
              currentPath={currentPath}
              path={path}
              subPaths={subPaths}
              title={title}
            />
          </li>
        ))
      }
    </ul>
  </div>

  <script>
    import '@scripts/nav-menu.ts'
  </script>
</nav>
<style>
  nav {
    height: theme(height.24);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: theme(space.2);
    padding: 0 theme(space.3);
  }

  #menu-backdrop {
    display: none;
    height: 100vh;
  }

  #menu-backdrop.blur {
    display: block;
    position: fixed;
    inset: 0;
    background: rgb(from #57bbbf r g b / 10%);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 25;
  }

  button {
    width: theme(spacing.11);
    height: theme(spacing.11);
    z-index: 100;
    justify-content: center;
    align-items: center;
    align-self: center;
  }

  button svg {
    height: 100%;
    width: 100%;
    pointer-events: none;
  }

  #menu-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.25s ease-in-out;
    position: absolute;
    inset: 0;
    width: 100%;
    z-index: 50;
    visibility: hidden;
    overflow: visible;
  }

  #menu-wrapper.expanded {
    grid-template-rows: 1fr;
    grid-template-columns: repeat(12, 1fr);
    min-height: 75vh;
    height: 75vh;
    visibility: visible;
    background: white;
    border-bottom: 2px solid black;
  }

  #navigation-menu {
    grid-column-start: 1;
    grid-column-end: 12;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: theme(space.2);
    padding: theme(space.4);
  }

  #logo-link {
    height: 4rem;
    width: 4rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #logo-type {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }

  #logo-type p {
    font-weight: bold;
    text-align: center;
  }

  @media (width >= theme(screens.sm)) {
    #navigation-menu {
      grid-column-start: 4;
      grid-column-end: 10;
      margin: 0 auto;
    }
  }

  @media (width >= theme(screens.md)) {
    nav#main-nav {
      max-width: theme(maxWidth.6xl);
      margin: 0 auto;
    }

    #menu-wrapper {
      position: relative;
      display: block;
    }

    #navigation-menu {
      flex-direction: row;
      padding: 0;
    }

    #menu-button {
      display: none;
    }

    #menu-backdrop {
      display: none;
    }

    #menu-backdrop.blur {
      display: none;
    }

    #menu-wrapper {
      background: none;
      transition: none;
      border-bottom: none;
      width: auto;
      visibility: visible;
    }

    li[data-subpaths='true'] {
      position: relative;
      display: flex;
      flex-direction: row;
      align-items: center;
    }
  }
</style>
