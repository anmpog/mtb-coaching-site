---
import { Icon } from 'astro-icon/components'
import siteData from '../data/site-data.json'
const { navLinks, logoType } = siteData
import { Image } from 'astro:assets'
import logo from '../assets/max-mtb-logo-lowres.png'
import NavLink from './NavLink.astro'

const currentPath = new URL(Astro.request.url).pathname
---

<nav class='main-nav' id='main-nav'>
  <div class='backdrop' id='menu-backdrop'></div>
  <a href='/' id='logo-link'>
    <Image alt='Max MTB Logo' id='logo-img' src={logo} />
  </a>
  <div class='logo-type' id='logo-type'>
    <p>{logoType}</p>
  </div>
  <button aria-expanded='false' aria-labelledby='button-label' id='menu-button'>
    <Icon focusable={'false'} name={'ion:menu'} title='site navigation' />
    <span hidden id='button-label'>Site Navigation</span>
  </button>

  <div id='menu-wrapper'>
    <ul id='menu'>
      {
        navLinks.map(({ title, path }) => (
          <NavLink currentPath={currentPath} path={path} title={title} />
        ))
      }
    </ul>
  </div>

  <script>
    import '../scripts/nav-menu.ts'
  </script>
</nav>
<style>
  /* 0.25rem is the tailwind equivalent of 1 unit of spacing */

  nav#main-nav {
    height: var(--nav-height-mobile);
    position: relative;
    display: flex;
    justify-content: space-between;
    padding: 1rem;
  }

  #menu-backdrop {
    display: none;
    height: 100vh;
  }

  #menu-backdrop.blur {
    display: block;
    position: fixed;
    inset: 0;
    backdrop-filter: blur(1px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 25;
  }

  #menu-button {
    width: calc(0.25rem * 10);
    height: calc(0.25rem * 10);
    z-index: 100;
    display: flex;
    justify-content: center;
    align-items: center;
    align-self: center;
  }

  #menu-button svg {
    height: 100%;
    width: 100%;
    pointer-events: none;
  }

  #menu-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.25s ease-in-out;
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    z-index: 50;
    visibility: hidden;
  }

  #menu-wrapper.expanded {
    grid-template-rows: 1fr;
    min-height: 75vh;
    visibility: visible;
  }

  #menu {
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: calc(0.25rem * 8);
    background: #fff;
    border-bottom: 2px solid black;
  }

  #menu li a {
    padding: calc(0.25rem * 4) calc(0.25rem * 6);
    outline: 1px solid black;
    display: inline-block;
  }

  #logo-link {
    height: 4rem;
    width: 4rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #logo-type {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  #logo-type p {
    font-weight: bold;
    text-align: center;
  }

  /* 768px comes from default "medium screen" value in Tailwind 3 */
  /* @media (width >= 768px) { */
  @media (width >= 768px) {
    nav#main-nav {
      @apply max-w-4xl;
      margin: 0 auto;
    }

    #menu-button {
      display: none;
    }

    #menu-backdrop {
      display: none;
    }

    #menu-backdrop.blur {
      display: none;
    }

    #menu-wrapper {
      display: flex;
      flex-direction: row;
      position: relative;
      background: none;
      transition: none;
      border-bottom: none;
      justify-content: flex-end;
      width: auto;
      visibility: visible;
    }

    #menu {
      flex-direction: row;
      gap: 1rem;
      padding: calc(0.25rem * 1);
      border: none;
    }

    #menu a:hover {
      cursor: pointer;
    }
  }
</style>
