---
import { Icon } from 'astro-icon/components'
import siteData from '../data/site-data.json'
const { navLinks } = siteData
---

<nav id='main-nav' class='main-nav'>
  <div id='menu-backdrop' class='backdrop'></div>
  <a id='logo-link' href='/'>
    <img
      id='logo-img'
      alt='Max MTB Logo'
      src='src/assets/max-mtb-logo-lowres.png'
    />
  </a>
  <button id='menu-button' aria-labelledby='button-label' aria-expanded='false'>
    <Icon name={'ion:menu'} title='site navigation' focusable={'false'} />
    <span id='button-label' hidden>Site Navigation</span>
  </button>

  <div id='menu-wrapper'>
    <ul id='menu'>
      {
        navLinks.map(({ title, path }) => (
          <li>
            <a href={path}>{title}</a>
          </li>
        ))
      }
    </ul>
  </div>

  <script>
    import '../scripts/nav-menu.ts'
  </script>
</nav>
<style>
  /* 0.25rem is the tailwind equivalent of 1 unit of spacing */

  nav#main-nav {
    position: relative;
    display: flex;
    justify-content: space-between;
    padding: 1rem;
  }

  #menu-backdrop {
    display: none;
  }

  #menu-backdrop.blur {
    position: fixed;
    top: 0;
    bottom: 0;
    right: 0;
    left: 0;
    backdrop-filter: blur(1px);
  }

  #menu-button {
    width: calc(0.25rem * 10);
    height: calc(0.25rem * 10);
    z-index: 100;
    display: flex;
    justify-content: center;
    align-items: center;
    align-self: center;
  }

  #menu-button:focus {
    outline: auto;
  }

  #menu-button svg {
    height: 100%;
    width: 100%;
    pointer-events: none;
  }

  #menu-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.25s ease-in-out;
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    border-bottom: 2px solid black;
  }

  #menu-wrapper.expanded {
    grid-template-rows: 1fr;
    min-height: 75vh;
  }

  #menu {
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: calc(0.25rem * 8);
    background: #fff;
  }

  /* #menu li {
    display: inline-block;
    font-size: 18px;
  } */

  #menu li a {
    padding: calc(0.25rem * 4) calc(0.25rem * 6);
    outline: 1px solid black;
    display: inline-block;
  }

  #logo-link {
    height: 4rem;
    width: 4rem;
  }

  /* add this to block scrolling when nav is open */
  /* 
  .block-scroll {
    position: relative;
    height: 100vh;
    overflow-y: hidden;
    touch-action: none;
  } */
</style>
