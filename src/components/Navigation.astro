---
import logo from '@assets/max-mtb-logo.png'
import siteData from '@data/site-data.json'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import NavLink from './NavLink.astro'
const { navLinks, logoType } = siteData

const requestPath = new URL(Astro.request.url).pathname
// Normalizing path because production env adds trailing slash
const currentPath = requestPath.split('/')[1]
---

<nav id='main-navigation'>
  <a href='/' id='logo-link'>
    <Image alt='Max MTB Logo' id='logo-img' src={logo} />
  </a>
  <div class='logo-type' id='logo-type'>
    <span class='font-semibold'>{logoType}</span>
  </div>
  <button
    aria-controls='menu-wrapper'
    aria-describedby='button-label'
    aria-expanded='false'
    aria-label='Navigation Menu Toggle'
    id='nav-menu-button'
    tabindex='0'
  >
    <Icon focusable='false' name={'ion:menu'} title='site navigation' />
    <span hidden id='button-label'>Site Navigation</span>
  </button>
  <div id='menu-wrapper'>
    <ul aria-label='Navigation Links' id='navigation-menu'>
      {
        navLinks.map(({ title, path, subPaths }) => (
          <li data-subpaths={subPaths ? 'true' : 'false'}>
            <NavLink
              currentPath={currentPath}
              path={path}
              subPaths={subPaths}
              title={title}
            />
          </li>
        ))
      }
    </ul>
  </div>

  <script>
    import '@scripts/nav-menu.ts'
  </script>
</nav>
<style>
  nav {
    position: relative;
    display: flex;
    justify-content: space-between;
    height: theme(height.24);
    align-items: center;
    gap: theme(space.2);
    padding: 0 theme(space.3);
    z-index: 1;
  }

  /* Want to appear between navigation menu wrapper and primary page content */
  nav::before {
    content: '';
    z-index: -1;
    position: fixed;
    visibility: hidden;
    opacity: 0;
    inset: 0;
    background: rgb(from #57bbbf r g b / 50%);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    overflow-y: hidden;

    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }

  body.js-enabled #nav-menu-button {
    /* display: inline-flex; */
    width: theme(spacing.11);
    height: theme(spacing.11);
    justify-content: center;
    align-items: center;
    z-index: 2;
  }

  #nav-menu-button svg {
    inset: 0;
    height: 100%;
    width: 100%;
    pointer-events: none;
  }

  #menu-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.25s ease-in-out;
    position: absolute;
    inset: 0;
    visibility: hidden;
    overflow: visible;
  }

  #nav-menu-button[aria-expanded='true'] ~ #menu-wrapper {
    grid-template-rows: 1fr;
    grid-template-columns: repeat(12, 1fr);
    min-height: 75vh;
    visibility: visible;
    background: white;
    border-bottom: 2px solid black;
  }

  nav:has(#nav-menu-button[aria-expanded='true'])::before {
    opacity: 1;
    visibility: visible;
  }

  #navigation-menu {
    grid-column-start: 1;
    grid-column-end: 12;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: theme(space.2);
    padding: theme(space.4);
  }

  #logo-link {
    height: theme(space.16);
    width: theme(space.16);
  }

  #logo-type {
    display: inline;
  }

  #logo-type span {
    font-weight: bold;
    text-align: center;
  }

  @media (width >= theme(screens.sm)) {
    #navigation-menu {
      grid-column-start: 4;
      grid-column-end: 10;
      margin: 0 auto;
    }
  }

  @media (width >= theme(screens.md)) {
    nav {
      max-width: theme(maxWidth.6xl);
      margin: 0 auto;
      justify-content: space-between;
    }

    #menu-wrapper {
      position: relative;
      display: inline;
      visibility: visible;
      transition: none;
      width: auto;
      border-bottom: none;
      background: none;
    }

    #navigation-menu {
      flex-direction: row;
      padding: 0;
      gap: theme(space.3);
    }

    body.js-enabled #nav-menu-button {
      display: none;
    }

    #menu-backdrop {
      display: none;
    }

    li[data-subpaths='true'] {
      position: relative;
      display: flex;
      align-items: stretch;
      gap: theme(space.2);
    }
  }
</style>
