---
import getLqip from '@utils/getLqip'
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

export interface Props {
  /** Imported image metadata. *
   * @example
   * ```astro
   * ---
   * import MyImage from '@assets/my-image.jpg'
   * ---
   * <SideBySideImage imageSrc={MyImage} />
   * ```
   */
  imageSrc: ImageMetadata

  /** A short but descriptive string that describes the image for users who are relying on screen readers. *
   * @example
   * ```astro
   * <SideBySideImage altText='An image of a mountain biker smiling' />
   * ```
   */
  altText: string
}

const { imageSrc, altText } = Astro.props
const lqip = getLqip(imageSrc)
---

<div class='relative aspect-[4/3] h-full w-full md:max-h-[32rem]'>
  <img
    alt='Blurred placeholder image'
    aria-hidden='true'
    class='absolute inset-0 h-full w-full scale-110 object-cover blur-xl'
    src={lqip}
  />
  <Picture
    alt={altText}
    class='absolute inset-0 h-full w-full object-cover text-transparent'
    fallbackFormat='jpg'
    formats={['avif', 'webp']}
    layout='full-width'
    sizes={`(max-width: 375px) 720px, (max-width: 720px) 1080px, (max-width: 1600px) 1200px, ${imageSrc.width}px`}
    src={imageSrc}
    widths={[375, 540, 720, 1200]}
  />
</div>
