---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

export interface Props {
  /**
   * Imported image metadata.
   *
   * @example
   * ```
   * import MyImage from '@assets/my-image.jpg'
   * <SideBySideImage imageSrc={MyImage} />
   * ```
   */
  imageSrc: ImageMetadata

  /**
   * A short but descriptive string that describes the image for users who are
   * relying on screen readers.
   *
   * @example
   *
   * ```
   * <SideBySideImage altText='An image of a mountain biker smiling' />
   * ```
   */
  altText: string
}

const { imageSrc, altText } = Astro.props
---

<div class='relative overflow-hidden md:max-h-[32rem]'>
  <!-- Ratio box to force aspect ratio -->
  <div class='pt-[75%]' id='ratio-box'></div>
  <Image
    alt={altText}
    class='absolute inset-0 h-full w-full content-center object-cover'
    layout='full-width'
    src={imageSrc}
  />
</div>
