---
export interface Props {
  /** The image source for the hero image */
  imageSrc: ImageMetadata
}

import type { ImageMetadata } from 'astro'
import heroData from '@data/site-data.json'
import getLqip from '@utils/getLqip.ts'
import { Picture } from 'astro:assets'
const { tagline, heroTitle, heroSubtext } = heroData
const { imageSrc } = Astro.props
const lqip = getLqip(imageSrc)
---

<div
  class='relative grid min-h-[calc(100vh-var(--nav-height-mobile))] content-stretch overflow-x-hidden [grid-template-areas:"stack"] md:min-h-[75vh]'
>
  <div class='relative flex overflow-hidden [grid-area:stack]'>
    <img
      alt='Blurred placeholder image'
      aria-hidden='true'
      class='z-0 h-full w-full scale-110 object-cover blur-xl'
      src={lqip}
    />
    <span class='absolute inset-0'></span>
  </div>
  <Picture
    alt='Image of Max coaching several riders'
    class='h-full w-full object-cover text-transparent'
    fallbackFormat='jpg'
    fetchpriority='high'
    formats={['avif', 'webp']}
    pictureAttributes={{
      class: '[grid-area:stack] h-full w-full object-cover z-10',
    }}
    priority={true}
    sizes={'(max-width: 375px) 1080px, 100vw'}
    src={imageSrc}
    widths={[375, 640, 750, 828, 1080, 1200]}
  />
  <div
    class='inset-0 z-20 flex h-full w-full flex-col bg-slate-950/50 [grid-area:stack]'
    id='hero-text-content'
  >
    <div
      class='mt-[calc(50%-var(--nav-height-mobile))] flex flex-col gap-4 self-center px-6 py-14 md:mt-[6em] md:max-w-[85ch] md:gap-6'
    >
      <p
        class='order-2 text-center text-base uppercase tracking-widest text-slate-50 md:order-none md:text-lg'
      >
        {tagline}
      </p>
      <h1
        class='order-1 text-center text-5xl uppercase tracking-widest text-slate-50 md:order-none md:text-8xl'
      >
        {heroTitle}
      </h1>
      <p
        class='hidden text-center text-xl capitalize text-slate-50 md:block md:text-2xl'
      >
        {heroSubtext}
      </p>
      <button class='btn btn-primary order-3 self-center md:order-none'>
        Book Now
      </button>
    </div>
  </div>
</div>
