---
export interface Props {
  /** A string to serve as the human-readable, visually displayed link title. */
  title: string

  /** A string that will serve as the href attribute to the underlying <a> element. */
  path: string

  /** A generated string value used for applying `.active` styling to nav links based on user's current location in the site. */
  currentPath: string
}

const { title, path, currentPath } = Astro.props
---

<li>
  <a
    class={currentPath === path.slice(1) ? 'active' : ''}
    data-text={title}
    href={path}
  >
    {title}
  </a>
</li>
<style>
  /* 0.25rem is the tailwind equivalent of 1 unit of spacing */

  a {
    display: inline-flex;
    align-items: center;
    flex-direction: column;
    font-size: inherit;
    text-decoration: none;
    font-weight: normal;
    padding: calc(0.25rem * 4) calc(0.25rem * 6);
    outline: 1px solid black;
  }

  a::after {
    content: attr(data-text);
    height: 0;
    visibility: hidden;
    overflow: hidden;
    user-select: none;
    pointer-events: none;
    font-weight: bold;
  }

  a.active {
    font-weight: bold;
    color: theme('colors.active-link');
    outline-color: theme('colors.active-link');
    outline-width: 2px;
  }

  a:focus {
    outline: auto;
  }

  /* 768px comes from default "medium screen" value in Tailwind 3 */
  @media (width >= 768px) {
    a {
      padding: calc(0.25rem * 2);
      outline: none;
    }
  }
</style>
