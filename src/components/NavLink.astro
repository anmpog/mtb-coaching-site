---
import { Icon } from 'astro-icon/components'

export interface Props {
  /** A string to serve as the human-readable, visually displayed link title. */
  title: string

  /** A string that will serve as the href attribute to the underlying <a> element. */
  path: string

  /** A generated string value used for applying `.active` styling to nav links based on user's current location in the site. */
  currentPath: string

  /** An optional array that allows for sub-navigation */
  subPaths?: { subPath: string; name: string }[]
}

const { title, path, currentPath, subPaths } = Astro.props
---

<a
  class:list={[
    currentPath === path.slice(1) ? 'active' : '',
    subPaths ? 'subpaths' : null,
    'navigation-link',
  ]}
  data-text={title}
  href={path}
>
  {title}
</a>
{
  subPaths ? (
    <>
      <label for={`${title}-subnavigation-toggle`}>
        <Icon name='ion:caret-up-circle-outline' title='Arrow Icon' />
        <input
          class='subnavigation-toggle'
          id={`${title}-subnavigation-toggle`}
          name={`${title} Subnavigation Button`}
          type='checkbox'
        />
        <span class='subnavigation-label' hidden>
          Subnavigation
        </span>
      </label>
      <ul class='subnavigation-menu'>
        {subPaths.map(({ subPath, name }) => (
          <li>
            <a class='subnavigation-link' data-text={name} href={subPath}>
              {name}
            </a>
          </li>
        ))}
      </ul>
    </>
  ) : null
}
<style>
  .navigation-link,
  .subnavigation-link {
    text-decoration: none;
    display: inline-grid;
    font-weight: normal;
  }

  .navigation-link {
    font-size: theme(fontSize.fs-lg);
    padding: theme(space.2) theme(space.4);
  }

  .subnavigation-link {
    font-size: inherit;
    padding: theme(space.1) theme(space.3) theme(space.1) 0;
  }

  .navigation-link.active {
    font-weight: 750;
    color: theme('colors.active-link');
    outline-color: theme('colors.active-link');
  }

  .navigation-link::after,
  .subnavigation-link::after {
    content: attr(data-text);
    height: 0;
    font-weight: 750;
    grid-area: 1/1;
    user-select: none;
    pointer-events: none;
    visibility: hidden;
  }

  .navigation-link:hover,
  .subnavigation-link:hover {
    font-weight: 750;
  }

  .subnavigation-menu {
    margin-left: theme(space.4);
    display: flex;
    flex-direction: column;
    gap: theme(space.1);
    margin-top: theme(space.1);
  }

  .subnavigation-menu li {
    list-style: none;
  }

  .subnavigation-menu li::before {
    content: '#';
    margin-right: theme(space.1);
    font-weight: bold;
    font-style: italic;
  }

  .navigation-link:focus {
    outline: auto;
  }

  label {
    display: none;
  }

  @media (width >= theme(screens.md)) {
    .navigation-link {
      font-size: inherit;
    }

    .subpaths.navigation-link {
      padding: theme(space.2) 0 theme(space.2) theme(space.4);
    }

    label {
      display: flex;
      position: relative;
      align-items: center;
      padding: theme(space.2) theme(space.4) theme(space.2) 0;
      cursor: pointer;
    }

    label svg {
      pointer-events: none;
    }

    input {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
    }

    .subnavigation-menu {
      margin: theme(space.3) 0 0 0;
      position: absolute;
      display: none;
      gap: theme(gap.1);
      padding: theme(spacing.4);
      outline-width: 2px;
      outline-color: theme(colors.slate.800);
      border-radius: theme(borderRadius.DEFAULT);
      background-color: theme(colors.slate.200);
      outline-style: solid;
      white-space: nowrap;
      inset-inline-start: 0;
      inset-block-start: 100%;
      text-transform: capitalize;
    }

    label:has(input:focus) {
      outline: auto;
    }

    label:has(input:checked) + ul.subnavigation-menu {
      display: flex;
      flex-direction: column;
    }

    label:has(input:checked) > svg {
      transform: rotate(180deg);
    }
  }
</style>
