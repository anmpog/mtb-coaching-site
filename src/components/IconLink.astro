---
export interface Props {
  title: string
  address: string
  iconName: string
  size?: number
}
import { Icon } from 'astro-icon/components'
const { title, address, iconName, size = 36 } = Astro.props
---

<a href={address} title={`Follow us on ${title}`}>
  <Icon
    name={`ion:${iconName}`}
    focusable='false'
    size={size}
    aria-hidden='true'
  />
</a>
