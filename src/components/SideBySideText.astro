---
export interface Props {
  /**
   * A title for the textual content. Will be fully uppercase.
   */
  contentTitle: string
  /**
   * The text content to display. Use backticks (``) to avoid having to escape special characters.
   */
  content: string
  /**
   * A string value that corresponds to the available slots in the <SideBySide /> component. `content` represents non-image content, while `image` represents image content.
   */
  slot: 'content'
}

const { contentTitle, content } = Astro.props
---

<div class='flex h-full flex-col px-6 py-14 font-sans' id='side-by-side-text'>
  <div class='flow-content flex h-full flex-col justify-center'>
    <h2 class='text-left font-heading text-3xl uppercase tracking-widest'>
      {contentTitle}
    </h2>
    <p class='max-w-[45ch]'>
      {content}
    </p>
  </div>
</div>
